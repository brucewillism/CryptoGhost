# =========================================================
# CryptoGhost v5.0 — Environment Template
# =========================================================
# 1. Copy:  cp .env.example .env
# 2. Fill in your values — NEVER commit .env
# 3. Generate secrets: openssl rand -hex 32
# =========================================================

# =========================================================
# APPLICATION
# =========================================================
CRYPTOGHOST_ENV=development
CRYPTOGHOST_APP_NAME=CryptoGhost
CRYPTOGHOST_DEBUG=true

CRYPTOGHOST_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32-min-32-chars
CRYPTOGHOST_JWT_SECRET=change-me-jwt-secret-min-32-characters-long

CRYPTOGHOST_PAPER_TRADING=true
CRYPTOGHOST_LIVE_TRADING_ENABLED=false

CRYPTOGHOST_PREMIUM_REASONING=false
CRYPTOGHOST_LOCAL_FIRST_STRATEGY=true

# =========================================================
# API
# =========================================================
CRYPTOGHOST_API_HOST=0.0.0.0
CRYPTOGHOST_API_PORT=8000
CRYPTOGHOST_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =========================================================
# JWT
# =========================================================
CRYPTOGHOST_JWT_ALGORITHM=HS256
CRYPTOGHOST_JWT_EXPIRE_MINUTES=60

# =========================================================
# DATABASE
# =========================================================
CRYPTOGHOST_DATABASE_URL=postgresql+asyncpg://cryptoghost:cryptoghost@localhost:5432/cryptoghost
CRYPTOGHOST_DATABASE_URL_SYNC=postgresql://cryptoghost:cryptoghost@localhost:5432/cryptoghost
CRYPTOGHOST_PGVECTOR_ENABLED=true

# =========================================================
# REDIS / CELERY
# =========================================================
CRYPTOGHOST_REDIS_URL=redis://localhost:6379/0
CRYPTOGHOST_CELERY_BROKER_URL=redis://localhost:6379/1
CRYPTOGHOST_CELERY_RESULT_BACKEND=redis://localhost:6379/2
CRYPTOGHOST_REDIS_STREAMS_ENABLED=true

# =========================================================
# EXCHANGES (your own accounts only — leave empty for paper)
# =========================================================
CRYPTOGHOST_BINANCE_API_KEY=
CRYPTOGHOST_BINANCE_API_SECRET=
CRYPTOGHOST_BINANCE_TESTNET=true

CRYPTOGHOST_BYBIT_API_KEY=
CRYPTOGHOST_BYBIT_API_SECRET=
CRYPTOGHOST_BYBIT_TESTNET=true

CRYPTOGHOST_ALPACA_API_KEY=
CRYPTOGHOST_ALPACA_API_SECRET=
CRYPTOGHOST_ALPACA_PAPER=true

CRYPTOGHOST_MT5_LOGIN=
CRYPTOGHOST_MT5_PASSWORD=
CRYPTOGHOST_MT5_SERVER=

# =========================================================
# RISK MANAGEMENT
# =========================================================
CRYPTOGHOST_MAX_DAILY_LOSS_PCT=2.0
CRYPTOGHOST_MAX_EXPOSURE_PCT=10.0
CRYPTOGHOST_DEFAULT_STOP_LOSS_PCT=1.5
CRYPTOGHOST_DEFAULT_TAKE_PROFIT_PCT=3.0
CRYPTOGHOST_TRAILING_STOP_PCT=0.5
CRYPTOGHOST_CIRCUIT_BREAKER_ENABLED=true

# =========================================================
# OBSERVABILITY
# =========================================================
CRYPTOGHOST_SENTRY_DSN=
CRYPTOGHOST_PROMETHEUS_ENABLED=true

# =========================================================
# NOTIFICATIONS
# =========================================================
CRYPTOGHOST_NOTIFICATION_WEBHOOK=
CRYPTOGHOST_NOTIFICATION_EMAIL=

# =========================================================
# ADMIN (change before production)
# =========================================================
CRYPTOGHOST_ADMIN_USERNAME=admin
CRYPTOGHOST_ADMIN_PASSWORD=change-me-secure-password

# =========================================================
# AI — OLLAMA (local or remote)
# =========================================================
CRYPTOGHOST_AI_PROVIDER_DEFAULT=ollama
CRYPTOGHOST_OLLAMA_ENABLED=true

# Remote Ollama server (optional)
CRYPTOGHOST_OLLAMA_URL=http://your-ollama-host:11434

# Local Ollama (docker-compose default)
CRYPTOGHOST_OLLAMA_BASE_URL=http://localhost:11434

CRYPTOGHOST_OLLAMA_MODEL=llama3.2:latest
CRYPTOGHOST_OLLAMA_MODEL_PRIMARY=llama3.2:latest
CRYPTOGHOST_OLLAMA_MODEL_SECONDARY=deepseek-r1
CRYPTOGHOST_OLLAMA_MODEL_REASONING=qwen2.5
CRYPTOGHOST_OLLAMA_MODEL_EMBEDDING=nomic-embed-text
CRYPTOGHOST_OLLAMA_EMBED_MODEL=nomic-embed-text
CRYPTOGHOST_OLLAMA_TIMEOUT=120
CRYPTOGHOST_OLLAMA_RETRY_MAX=3
CRYPTOGHOST_OLLAMA_RETRY_BACKOFF=1.5
CRYPTOGHOST_OLLAMA_MODELS=llama3,deepseek-r1,mistral,qwen2.5,phi3

# Premium AI (optional — leave empty for local-first)
CRYPTOGHOST_OPENAI_API_KEY=
CRYPTOGHOST_OPENAI_MODEL=gpt-4o-mini
CRYPTOGHOST_ANTHROPIC_API_KEY=
CRYPTOGHOST_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
CRYPTOGHOST_GEMINI_API_KEY=
CRYPTOGHOST_GEMINI_MODEL=gemini-1.5-flash
CRYPTOGHOST_AI_REQUEST_TIMEOUT=60
CRYPTOGHOST_FINBERT_ENABLED=true
CRYPTOGHOST_EMBEDDING_DIMENSIONS=384

# =========================================================
# INTELLIGENCE v2
# =========================================================
CRYPTOGHOST_INTELLIGENCE_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
CRYPTOGHOST_INTELLIGENCE_ANALYSIS_INTERVAL=120

# =========================================================
# QUANT v3
# =========================================================
CRYPTOGHOST_RL_TRAINING_EPISODES=50
CRYPTOGHOST_GPU_INFERENCE_ENABLED=true
CRYPTOGHOST_FEATURE_STORE_TTL=300
CRYPTOGHOST_EVENT_BUS_ENABLED=true
CRYPTOGHOST_GPU_ENABLED=true
CRYPTOGHOST_CUDA_ENABLED=false

# =========================================================
# INVESTMENT v4
# =========================================================
CRYPTOGHOST_INVESTMENT_UNIVERSE=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,ADA/USDT
CRYPTOGHOST_MAX_SINGLE_ALLOCATION_PCT=35.0
CRYPTOGHOST_MIN_CASH_ALLOCATION_PCT=20.0
CRYPTOGHOST_PREMIUM_AI_FOR_EXPLANATIONS=false

# =========================================================
# SELF-IMPROVING v5
# =========================================================
CRYPTOGHOST_SELF_IMPROVEMENT_ENABLED=true
CRYPTOGHOST_DATA_LAKE_PATH=data/lake
CRYPTOGHOST_DRIFT_RETRAIN_THRESHOLD=0.2
CRYPTOGHOST_SURVIVAL_EMERGENCY_THRESHOLD=25.0
CRYPTOGHOST_META_LEARNING_ENABLED=true
CRYPTOGHOST_ML_AUTO_RETRAIN=true
CRYPTOGHOST_ML_DRIFT_DETECTION=true

# =========================================================
# PREMIUM DATA APIs (optional)
# =========================================================
CRYPTOGHOST_FRED_API_KEY=
CRYPTOGHOST_GLASSNODE_API_KEY=
CRYPTOGHOST_COINGLASS_API_KEY=
CRYPTOGHOST_ALPHAVANTAGE_API_KEY=
CRYPTOGHOST_SANTIMENT_API_KEY=
CRYPTOGHOST_FINNHUB_API_KEY=
CRYPTOGHOST_POLYGON_API_KEY=
